# =============================================================
# SkillGap AI — Environment Variables
# Copy this file to .env and replace every placeholder value
# before running docker compose. NEVER commit the real .env file.
# =============================================================

FLASK_ENV=production

# Flask / JWT secrets — generate strong random values, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_secret
JWT_SECRET_KEY=change_this_jwt_secret

# MongoDB connection used by the Flask backend.
# Must match the root credentials configured below.
MONGO_URI=mongodb://admin:change_this_root_password@mongodb:27017/skillgap?authSource=admin
MONGO_DB_NAME=skillgap

# MongoDB container root credentials
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_this_root_password

# Ports
BACKEND_PORT=5678
FRONTEND_PORT=8050

# CORS — the origin(s) allowed to call the API directly (not needed
# when the frontend proxies through Nginx, but kept for direct API use)
CORS_ORIGINS=http://localhost:8050
